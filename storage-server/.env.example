PORT=4321
HOST=0.0.0.0
# Strong secret token required for private API/setup access (auto-generated by setup-mini-server.sh)
DIARY_STORAGE_TOKEN=
# Dedicated session signing secret for member login tokens (auto-generated on boot if blank)
DIARY_SESSION_SECRET=
# Comma-separated browser origins permitted to query this API (NEVER set '*' on public servers)
ALLOWED_ORIGINS=https://kaushalboii.github.io
# Allow new users without an invite code to submit a pending request that awaits Owner approval (true | false)
ALLOW_ACCESS_REQUESTS=true
# Optional explicit path for storing diary JSON and uploaded images (keep chmod 700)
DATA_DIR=./data
