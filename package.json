{
  "name": "mydiary-complete-shelf",
  "version": "1.0.0",
  "private": true,
  "author": "M Kaushal Maran (https://github.com/kaushalboii)",
  "type": "module",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5203",
    "dev:storage": "node storage-server/server.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "npx serve out -l 5203",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/newsreader": "5.2.8",
    "lucide-react": "^0.511.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  }
}
